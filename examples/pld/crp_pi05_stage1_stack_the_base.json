{
  "robot": {
    "type": "crp_arm",
    "port": "192.168.0.100",
    "use_gripper_feature": true,
    "cameras": {
      "top": {
        "type": "opencv",
        "index_or_path": 14,
        "width": 640,
        "height": 480,
        "fps": 30
      },
      "wrist": {
        "type": "opencv",
        "index_or_path": 6,
        "width": 640,
        "height": 480,
        "fps": 30
      }
    }
  },
  "base_policy": {
    "path": "outputs/models/pi05_stack_the_base_all/checkpoints/080000/pretrained_model"
  },
  "residual_policy": {
    "type": "residual_gaussian",
    "device": "cuda",
    "vision_encoder_name": "lerobot/resnet10",
    "freeze_vision_encoder": true,
    "shared_encoder": true,
    "actor_network_kwargs": {
      "hidden_dims": [256, 256],
      "activate_final": true,
      "activations": "Tanh"
    },
    "state_encoder_hidden_dim": 256,
    "latent_dim": 256,
    "normalization_mapping": {
      "VISUAL": "MEAN_STD",
      "STATE": "MIN_MAX",
      "ENV": "MIN_MAX",
      "ACTION": "MIN_MAX"
    }
  },
  "reward_classifier": {
    "path": "outputs/reward_classifier/models/stack_the_base/checkpoints/003000/pretrained_model",
    "device": "cuda",
    "success_threshold": 0.99,
    "success_reward": 1.0,
    "terminate_on_success": true,
    "manual_fallback": true
  },
  "pld": {
    "n_offline_success_trials": 10,
    "calql_steps": 2000,
    "calql_alpha": 1.0,
    "rl_steps": 5000,
    "warmup_episodes": 5,
    "avg_episode_steps": 500,
    "online_buffer_capacity": 50000,
    "offline_buffer_capacity": 5000,
    "buffer_optimize_memory": true,
    "batch_size": 256,
    "online_ratio": 0.5,
    "online_step_before_learning": 100,
    "max_episode_steps": 1000,
    "episode_reset_time_s": 15,
    "manual_scene_reset_pause_key": "space",
    "xi": 0.05,
    "collect_env_steps_per_iter": 800,
    "finish_episode_before_round_stop": true,
    "train_iters_per_collect": 50,
    "discount": 0.99,
    "grad_clip_norm": 1.0,
    "actor_lr": 0.0003,
    "critic_lr": 0.0003,
    "temperature_lr": 0.0003,
    "temperature_init": 1.0,
    "critic_target_update_weight": 0.005,
    "num_critics": 2,
    "utd_ratio": 2,
    "policy_update_freq": 1,
    "use_adamw": true,
    "optimizer_weight_decay": 0.01
  },
  "inference": {
    "type": "rtc",
    "rtc": {
      "execution_horizon": 10
    }
  },
  "fps": 30,
  "task": "Insert the purple base in the black base",
  "device": "cuda",
  "interpolation_multiplier": 2,
  "multiprocess_sync_inference": true,
  "output_dir": "outputs/pld_stage1_pi05_stack_the_base_all",
  "job_name": "pld_stage1_pi05_stack_the_base_all"
}
