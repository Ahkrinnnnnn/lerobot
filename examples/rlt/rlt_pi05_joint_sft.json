{
  "dataset": {
    "repo_id": "local/insert_the_blue_tube_all",
    "root": "/media/dingyuxuan/My Passport/insert_the_blue_tube_all"
  },
  "policy": {
    "type": "rlt",
    "device": "cuda",
    "rlt_finetune_vla": true,
    "base_policy": {
      "type": "pi05",
      "path": "outputs/models/pi05_insert_the_blue_tube/checkpoints/140000/pretrained_model",
