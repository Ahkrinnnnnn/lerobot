  "use_policy_training_preset": true,
  "batch_size": 8,
  "num_workers": 4,
  "steps": 20000,
  "log_freq": 50,
  "save_freq": 5000,
  "save_checkpoint": true,
  "seed": 42,
  "output_dir": "outputs/models/rlt_pi05_joint_sft_insert_the_blue_tube",
  "job_name": "rlt_pi05_joint_sft_insert_the_blue_tube",
  "wandb": {
    "enable": false,
    "project": "lerobot-rlt"
  }
}
